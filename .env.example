# Balaji Computer - Root Environment Variables Template

# Backend Configuration (server/.env)
PORT=8080
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.example.mongodb.net/Balajicomputer?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
NODE_ENV=development
ALLOW_OFFLINE_DEMO=false

# Initial Administrator Seed Credentials
ADMIN_NAME=Admin Balaji
ADMIN_EMAIL=admin@balajicomputer.edu
ADMIN_PASSWORD=ChangeThisPasswordInProduction@2026

# Frontend Configuration (client/.env)
VITE_API_URL=http://localhost:8080/api
